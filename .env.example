# Supabase — Project Settings → API
# Neither of these is a secret: they are inlined into the app bundle by design.
# Your data is protected by the RLS policies in supabase/migrations/, not by hiding these.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Playwright end-to-end test account (Authentication → Users → Add user).
# Used only by the test suite; separate from your real Google-backed account.
E2E_EMAIL=
E2E_PASSWORD=

# NEVER put the service_role key or the Google OAuth client secret in this file.
# The service_role key bypasses RLS entirely; the Google client secret belongs
# only in the Supabase dashboard (Authentication → Providers → Google).
