{
  "name": "petfile",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "expo start",
    "android": "JAVA_HOME=$(/usr/libexec/java_home -v 17) ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android",
    "android:apk": "cd android && JAVA_HOME=$(/usr/libexec/java_home -v 17) ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:usb": "expo start --localhost --dev-client --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:fix": "eslint . --fix"
  },
  "private": true,
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/ui": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.3",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.41.0",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
