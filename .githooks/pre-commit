#!/bin/sh
# Refuse to commit .env files or anything that looks like a Supabase or
# Google secret.

# Any .env* file (.env, .env.local, .env.production, ...) except the
# committed .env.example template. The exclusion is done with a plain shell
# `case`, not `grep -v`, because `grep -q` combined with `-v` is unreliable
# across grep implementations (observed returning the wrong exit status on
# at least one) — a portable `case` match avoids depending on that.
env_files=$(git diff --cached --name-only | grep -E '(^|/)\.env($|\.)')
if [ -n "$env_files" ]; then
  found_real_env=0
  old_ifs=$IFS
  IFS='
'
  for f in $env_files; do
    case "$f" in
      *.env.example) ;;
      *) found_real_env=1 ;;
    esac
  done
  IFS=$old_ifs
  if [ "$found_real_env" = "1" ]; then
    echo "BLOCKED: .env files must never be committed (except .env.example)." >&2
    exit 1
  fi
fi

# Content that looks like a secret: legacy Supabase JWT (anon/service_role),
# new-format Supabase secret key (sb_secret_...), a service-role-named
# assignment regardless of letter case, or a Google OAuth client secret
# (GOCSPX-...).
if git diff --cached -U0 | grep -qiE 'service_role[A-Za-z_]*[[:space:]]*[:=]|eyJ[A-Za-z0-9_-]{20,}\.|sb_secret_[A-Za-z0-9_-]{10,}|GOCSPX-[A-Za-z0-9_-]{10,}'; then
  echo "BLOCKED: staged changes look like they contain a Supabase secret key or a Google OAuth client secret." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Format what is being committed.
# ---------------------------------------------------------------------------
#
# After the secret checks, never before: formatting cannot introduce a secret,
# and a commit that is going to be refused should be refused before anything
# rewrites the working tree.
#
# `prettier-plugin-tailwindcss` is the reason this exists. Two editors with two
# different class orders churn every file they touch, so the order is decided
# here, once, for whoever commits.
#
# **Caveat worth knowing:** the files are re-staged after formatting, so a
# partially staged file (`git add -p`) gets the rest of its working copy staged
# too. Prettier rewrites whole files, so a partial stage was already going to
# be inconsistent — but the surprise is real, and this is where it comes from.
staged=$(mktemp)
git diff --cached --name-only --diff-filter=ACMR -z > "$staged"

if [ -s "$staged" ]; then
  if ! xargs -0 npx prettier --write --ignore-unknown --log-level warn < "$staged"; then
    echo "BLOCKED: prettier could not format the staged files." >&2
    rm -f "$staged"
    exit 1
  fi
  xargs -0 git add < "$staged"
fi

rm -f "$staged"

exit 0
